{
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "bessemer/*",
    "!bessemer/zodios-express",
    "simulacrum/apps/*",
    "simulacrum/packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "docgen": "yarn workspaces foreach --all --exclude bessemer run docgen && node scripts/docs.mjs",
    "clean": "turbo run clean && rm -rf .turbo",
    "clean-install": "turbo run clean && rm -rf node_modules && rm -rf .turbo"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/runtime": "7.27.0",
    "@effect/docgen": "0.5.2",
    "@effect/markdown-toc": "0.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-jest": "29.7.0",
    "jest": "29.7.0",
    "prettier": "2.7.1",
    "ts-jest": "29.2.5",
    "tsx": "4.21.0",
    "turbo": "2.5.5",
    "typescript": "7.0.2"
  }
}
