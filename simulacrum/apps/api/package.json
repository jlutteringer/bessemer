{
  "name": "@simulacrum/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && node scripts/build.mjs",
    "start": "node dist/index.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:up": "docker compose -f ../../docker-compose.yml up -d --wait",
    "db:down": "docker compose -f ../../docker-compose.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "prettier-fix": "prettier --write .",
    "clean": "rm -rf dist dist-lambda src/generated && rm -rf .turbo"
  },
  "dependencies": {
    "@bessemer/cornerstone": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@simulacrum/common": "workspace:*",
    "@simulacrum/ruleset": "workspace:*",
    "@simulacrum/ruleset-dnd4e": "workspace:*",
    "@simulacrum/ruleset-dnd5e": "workspace:*",
    "@simulacrum/ruleset-khydrian-drift": "workspace:*",
    "@simulacrum/ruleset-pf2e": "workspace:*",
    "aws-jwt-verify": "5.2.1",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "serverless-http": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "esbuild": "0.27.4",
    "prisma": "7.10.1",
    "tsx": "4.21.0"
  }
}
